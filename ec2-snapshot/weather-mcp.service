[Unit]
Description=Weather MCP server
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/weather-mcp
ExecStart=/home/ubuntu/weather-mcp/.venv/bin/python /home/ubuntu/weather-mcp/weather_server.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
